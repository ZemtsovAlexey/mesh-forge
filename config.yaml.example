llm:
  # lmstudio = local GPU (LM Studio). openai = any OpenAI-compatible Chat Completions API.
  provider: lmstudio
  base_url: http://127.0.0.1:1234/v1
  api_key: lm-studio
  planner_model: qwen2.5-7b-instruct
  vision_model: qwen2.5-vl-7b-instruct
  # Example — AI Tunnel:
  # provider: openai
  # base_url: https://api.aitunnel.ru/v1
  # api_key: sk-aitunnel-...
  # planner_model: gpt-5.6-luna
  # vision_model: gpt-5.6-luna
paths:
  openscad: ""
  projects: ""
server:
  host: 0.0.0.0
  port: 7860
gpu:
  vram_gb: 0
  # true = unload LM Studio / ComfyUI when the GPU slot switches kind (needed on 8GB).
  # false = FIFO queue only; both may stay loaded if VRAM allows.
  # Ignored when services are on different hosts — there is no VRAM competition.
  sequential_models: true
  # auto (omit) = one queue if llm and comfy hosts match, else independent queues.
  # true = always one shared queue + unload. false = always two queues, no unload.
  # shared_gpu: true
comfyui:
  enabled: true
  # Local GPU: http://127.0.0.1:8188
  # Another machine: http://192.168.1.20:8188
  # On that host start ComfyUI with --listen 0.0.0.0 (scripts/start-comfyui.ps1 -ListenHost 0.0.0.0)
  base_url: http://127.0.0.1:8188
  # Empty = auto-detect (ComfyUI Desktop user data, else portable).
  # Desktop example: C:/Users/<you>/Documents/ComfyUI
  # Portable example: C:/Users/<you>/AppData/Local/MeshForge/ComfyUI_windows_portable/ComfyUI
  install_dir: ""
  workflow: ""
  text_to_multiview_workflow: ""
  multiview_to_mesh_workflow: ""
  image_to_mesh_workflow: ""
  # draft | quality
  quality_preset: draft
  # orbits are always Zero123
  view_consistency: zero123
  # clay | color — clay лучше для mesh; color даёт цветные виды
  view_style: clay
  checkpoint: sd_xl_turbo_1.0_fp16.safetensors
  mesh_checkpoint: hunyuan3d-dit-v2-mv-turbo_fp16.safetensors
  image_checkpoint: hunyuan3d-dit-v2-mv-turbo_fp16.safetensors
  zero123_checkpoint: stable_zero123.ckpt
  negative_prompt: blurry, lowpoly, cropped, watermark, text, logo, frame, busy background, multiple subjects, different pose
  width: 768
  height: 768
  steps: 8
  cfg: 1.5
  view_count: 4
  view_denoise: 0.58
  view_denoise_turbo: 0.72
  edit_denoise: 0.28
  view_sampler: euler
  view_scheduler: sgm_uniform
  zero123_width: 256
  zero123_height: 256
  zero123_steps: 20
  zero123_cfg: 3.0
  zero123_sampler: euler
  zero123_scheduler: normal
  zero123_elevation: 0
  zero123_azimuth_left: -90
  zero123_azimuth_back: 180
  zero123_azimuth_right: 90
  mesh_resolution: 3072
  mesh_steps: 20
  mesh_cfg: 4.0
  mesh_guidance: 3.5
  mesh_octree_resolution: 256
  mesh_num_chunks: 8000
segmentation:
  # Comfy-first segmentation scaffold: detector + segmenter live on the ComfyUI host.
  enabled: false
  provider: comfyui
  detector: groundingdino
  detector_backend: grounding
  detector_model: IDEA-Research/grounding-dino-tiny
  detector_node_repo: https://github.com/PozzettiAndrea/ComfyUI-Grounding.git
  detector_device: cuda
  detector_dtype: float16
  segmenter: sam3
  segmenter_backend: sam3
  segmenter_model: sam3.1_multiplex_fp16.safetensors
  # Empty = reuse comfyui.base_url.
  segmenter_base_url: ""
  workflow_detect: ""
  workflow_segment: ""
  render_size: 768
  max_views: 4
  sequential: true
  min_box_score: 0.12
  mask_threshold: 0.5
  projection_min_views: 2
  debug_emit_every_step: true
  free_gpu_between_steps: true
photo:
  target_height_mm: 160
  mesh_postprocess: true
  finalize_target_faces: 120000
  finalize_smooth_iters: 3
  finalize_min_edge_mm: 0.08
  finalize_close_holes: true
  finalize_voxel_mm: 0
